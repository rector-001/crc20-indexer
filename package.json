{
  "name": "crc20-indexer",
  "version": "0.1.0",
  "description": "Open-source indexer and public API for CRC-20 covenant tokens on Bitcoin (BONS and BONS launchpad tokens)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "crc20": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p . && node -e \"require('node:fs').cpSync('src/pinned','dist/pinned',{recursive:true})\"",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:e2e": "node test/e2e/live-regtest.mjs",
    "typecheck": "tsc -p . --noEmit",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.1.1",
    "@noble/curves": "^1.9.7",
    "bitcoinjs-lib": "^6.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "secp256k1": "^5.0.2"
  },
  "keywords": [
    "bitcoin",
    "crc-20",
    "indexer",
    "taproot",
    "covenant",
    "tokens",
    "ord"
  ],
  "files": [
    "dist",
    "docs",
    "deploy",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rector-001/crc20-indexer.git"
  },
  "homepage": "https://github.com/rector-001/crc20-indexer#readme",
  "bugs": {
    "url": "https://github.com/rector-001/crc20-indexer/issues"
  }
}
